# CareLoop Backend Environment Configuration
NODE_ENV=development
PORT=5000

# Client origin allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Bookings use transactions, so MongoDB MUST run as a replica set:
#   - MongoDB Atlas (free tier works):   mongodb+srv://<user>:<password>@cluster.mongodb.net
#   - Local single-node replica set:     mongodb://localhost:27017/?replicaSet=rs0
#     (start with `mongod --replSet rs0 --dbpath <dir>` and run `rs.initiate()` once in mongosh)
MONGODB_URI=
MONGODB_DB_NAME=careloop

# Authentication Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with this placeholder or any value under 32 characters.
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=24h

# Clinic-local timezone for schedules and spoken times (defaults to Asia/Kolkata when DEPLOYMENT_REGION=IN)
DEFAULT_TIMEZONE=Asia/Kolkata

# Development Seeding (synthetic demo data only; never use real credentials)
SEED_CLINICIAN_NAME=Dr. Kavita Rao
SEED_CLINICIAN_EMAIL=clinician@careloop.local
SEED_CLINICIAN_PASSWORD=CareLoop2026!

# Telephony (Twilio) Configuration
# Leave empty or set VOICE_MOCK_MODE=true for local mock simulation
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
PUBLIC_URL=https://your-tunnel-subdomain.ngrok-free.app

# Voice Agent (Ultravox AI) Configuration
ULTRAVOX_API_KEY=your-ultravox-api-key
ULTRAVOX_MODEL=ultravox-v0.7
ULTRAVOX_VOICE=Riya
ULTRAVOX_LANGUAGE_HINT=hi

# Regional Emergency Safety Configuration (Default: IN -> 112)
DEPLOYMENT_REGION=IN
EMERGENCY_NUMBER=112

# Voice Mock Mode (Set to true to simulate without real Twilio/Ultravox credentials)
# Refused in production. Synthetic patients (+1 555 numbers) are always simulated regardless.
VOICE_MOCK_MODE=false

# Express Reverse Proxy Trust (Default: loopback. Use '1' or 'true' for reverse proxies/ALB/ngrok)
TRUST_PROXY=loopback

# Clinic Facility Configuration (Standardized)
# Optional for development/demo mode (defaults to labeled synthetic demo facility).
# In production (NODE_ENV=production), explicit facility name and address are required
# to prevent fictional synthetic demo data from being displayed to patients.
CLINIC_FACILITY_NAME=
CLINIC_ADDRESS=
CLINIC_SUITE=
CLINIC_CHECK_IN_DESK=
CLINIC_PHONE=
CLINIC_EMAIL=
CLINIC_HOURS=

# Missed-Call Callback (Milestone M8.1) Configuration
# When enabled, an inbound call acts as a trigger and CareLoop places an outbound callback.
# Defaults to false (direct streaming inbound voice assistant mode).
VOICE_CALLBACK_ENABLED=false
# Per-number cooldown before a second callback can be dispatched (in seconds, default: 300)
VOICE_CALLBACK_COOLDOWN_SECONDS=300
# Maximum callback attempts permitted per phone number per 24 hours (default: 3)
VOICE_CALLBACK_MAX_ATTEMPTS=3
# Enforce explicit first-time patient consent before placing automated callbacks (default: true)
VOICE_CALLBACK_REQUIRE_CONSENT=true


# PlanPilot agent (Phase 4)
# Without an LLM the agent decides with built-in rules. With one, the LLM picks from the same
# server-checked list of allowed actions, and the rules are the fallback for bad or slow answers.
# Provider: none | gemini
PLANPILOT_LLM_PROVIDER=none
GEMINI_API_KEY=
PLANPILOT_LLM_MODEL=gemini-2.5-flash
PLANPILOT_LLM_TIMEOUT_MS=10000
# Re-check every active care plan automatically every N minutes (0 = off; use the Run button)
PLANPILOT_AGENT_INTERVAL_MINUTES=0
